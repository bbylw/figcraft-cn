import Hero from "../components/sections/Hero.astro";
import Showcase from "../components/sections/Showcase.astro";
import Look from "../components/sections/Look.astro";
import Features from "../components/sections/Features.astro";
import Agents from "../components/sections/Agents.astro";
import HowItWorks from "../components/sections/HowItWorks.astro";
import Proof from "../components/sections/Proof.astro";
import Gallery from "../components/sections/Gallery.astro";
import Privacy from "../components/sections/Privacy.astro";
import Apps from "../components/sections/Apps.astro";
