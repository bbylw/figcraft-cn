---
import "@fontsource/work-sans/300.css";
import "@fontsource/work-sans/400.css";
import "@fontsource/work-sans/500.css";
import "../styles/global.css";
import { hero, nav, site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} · 开源、纯 Rust 的界面设计工具`, description = site.description } =
  Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e6e6e3" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/img/apps/figcraft.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="/img/apps/figcraft.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body>
    <div class="rbar" data-reading-bar aria-label="章节快速导航">
      <div class="rbar__progress" data-reading-progress></div>
      <div class="rbar__inner">
        <a href="#" class="rbar__brand">FigCraft</a>
        <nav class="rbar__nav" aria-label="阅读章节导航">
          {
            nav.map((n) => (
              <a
                class="rbar__link"
                href={n.href}
                data-spy-link={n.href.replace(/^#/, "")}
              >
                {n.label}
              </a>
            ))
          }
        </nav>
        <div class="rbar__action">
          <a class="rbar__cta" href={hero.primary.href}>{hero.primary.label}</a>
        </div>
      </div>
    </div>

    <slot />

    <div
      class="lightbox"
      data-lightbox
      role="dialog"
      aria-modal="true"
      aria-label="高清界面与作品检视"
      aria-hidden="true"
    >
      <div class="lightbox__backdrop" data-lightbox-close></div>
      <div class="lightbox__panel">
        <div class="lightbox__top">
          <div class="lightbox__meta">
            <span class="lightbox__count" data-lightbox-count>01 / 01</span>
            <strong class="lightbox__title" data-lightbox-title></strong>
            <code class="lightbox__file" data-lightbox-file></code>
          </div>
          <div class="lightbox__controls">
            <button
              type="button"
              class="lightbox__btn"
              data-lightbox-prev
              aria-label="上一张 (方向键左)"
            >
              ← 上一张
            </button>
            <button
              type="button"
              class="lightbox__btn"
              data-lightbox-next
              aria-label="下一张 (方向键右)"
            >
              下一张 →
            </button>
            <button
              type="button"
              class="lightbox__btn lightbox__btn--close"
              data-lightbox-close
              aria-label="关闭检视 (Esc)"
            >
              关闭 · Esc
            </button>
          </div>
        </div>
        <div class="lightbox__stage" data-lightbox-close>
          <img
            class="lightbox__img"
            data-lightbox-img
            src="/img/shot-2-components.png"
            alt=""
            referrerpolicy="no-referrer"
          />
        </div>
        <p class="lightbox__cap" data-lightbox-cap></p>
      </div>
    </div>

    <script is:inline>
      (function () {
        var ready = function () {
          document.body.classList.add("is-ready");
        };
        if (document.readyState === "complete") requestAnimationFrame(ready);
        else
          window.addEventListener("load", function () {
            requestAnimationFrame(ready);
          });

        var items = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window)) {
          items.forEach(function (el) {
            el.classList.add("is-in");
          });
        } else {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  e.target.classList.add("is-in");
                  io.unobserve(e.target);
                }
              });
            },
            { rootMargin: "0px 0px -10% 0px", threshold: 0.06 }
          );
          items.forEach(function (el) {
            io.observe(el);
          });
        }

        /* 滚动吸顶阅读栏与章节高亮 */
        var rbar = document.querySelector("[data-reading-bar]");
        var prog = document.querySelector("[data-reading-progress]");
        var spyLinks = document.querySelectorAll("[data-spy-link]");
        var sectionIds = ["look", "features", "agents", "under-the-hood", "made-in-figcraft"];
        var sections = sectionIds
          .map(function (id) {
            return document.getElementById(id);
          })
          .filter(Boolean);

        var updateScroll = function () {
          var y = window.scrollY || window.pageYOffset || 0;
          var vh = window.innerHeight || 800;
          var docH = Math.max(
            document.documentElement.scrollHeight - vh,
            1
          );
          var ratio = Math.min(Math.max(y / docH, 0), 1);

          if (rbar) {
            rbar.classList.toggle("is-visible", y > vh * 0.62);
          }
          if (prog) {
            prog.style.transform = "scaleX(" + ratio.toFixed(4) + ")";
          }

          var activeId = "";
          var probeY = y + vh * 0.34;
          for (var i = 0; i < sections.length; i++) {
            var s = sections[i];
            if (s && s.offsetTop <= probeY) {
              activeId = s.id;
            }
          }
          spyLinks.forEach(function (link) {
            var target = link.getAttribute("data-spy-link");
            link.classList.toggle("is-active", target === activeId);
          });
        };

        updateScroll();
        window.addEventListener("scroll", updateScroll, { passive: true });
        window.addEventListener("resize", updateScroll);

        /* 高清截图与作品灯箱检视 */
        var lb = document.querySelector("[data-lightbox]");
        var lbImg = document.querySelector("[data-lightbox-img]");
        var lbTitle = document.querySelector("[data-lightbox-title]");
        var lbFile = document.querySelector("[data-lightbox-file]");
        var lbCap = document.querySelector("[data-lightbox-cap]");
        var lbCount = document.querySelector("[data-lightbox-count]");
        var triggers = Array.prototype.slice.call(
          document.querySelectorAll("[data-zoom-src]")
        );
        var currentIdx = -1;

        var renderLightbox = function (idx) {
          if (!lb || !triggers.length) return;
          currentIdx = (idx + triggers.length) % triggers.length;
          var el = triggers[currentIdx];
          var src = el.getAttribute("data-zoom-src") || "";
          var title = el.getAttribute("data-zoom-title") || "";
          var cap = el.getAttribute("data-zoom-caption") || "";
          var file = el.getAttribute("data-zoom-file") || "";

          if (lbImg) {
            lbImg.setAttribute("src", src);
            lbImg.setAttribute("alt", title);
          }
          if (lbTitle) lbTitle.textContent = title;
          if (lbCap) lbCap.textContent = cap;
          if (lbFile) {
            lbFile.textContent = file;
            lbFile.style.display = file ? "inline-block" : "none";
          }
          if (lbCount) {
            var c1 = String(currentIdx + 1).padStart(2, "0");
            var c2 = String(triggers.length).padStart(2, "0");
            lbCount.textContent = c1 + " / " + c2;
          }
        };

        var openLightbox = function (idx) {
          if (!lb) return;
          renderLightbox(idx);
          lb.classList.add("is-open");
          lb.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
        };

        var closeLightbox = function () {
          if (!lb) return;
          lb.classList.remove("is-open");
          lb.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
        };

        triggers.forEach(function (el, idx) {
          el.addEventListener("click", function () {
            openLightbox(idx);
          });
          el.addEventListener("keydown", function (ev) {
            if (ev.key === "Enter" || ev.key === " ") {
              ev.preventDefault();
              openLightbox(idx);
            }
          });
        });

        var closeBtns = document.querySelectorAll("[data-lightbox-close]");
        closeBtns.forEach(function (btn) {
          btn.addEventListener("click", function (ev) {
            if (ev.target === btn) closeLightbox();
          });
        });

        var prevBtn = document.querySelector("[data-lightbox-prev]");
        var nextBtn = document.querySelector("[data-lightbox-next]");
        if (prevBtn) {
          prevBtn.addEventListener("click", function () {
            renderLightbox(currentIdx - 1);
          });
        }
        if (nextBtn) {
          nextBtn.addEventListener("click", function () {
            renderLightbox(currentIdx + 1);
          });
        }

        window.addEventListener("keydown", function (ev) {
          if (!lb || !lb.classList.contains("is-open")) return;
          if (ev.key === "Escape") closeLightbox();
          else if (ev.key === "ArrowLeft") renderLightbox(currentIdx - 1);
          else if (ev.key === "ArrowRight") renderLightbox(currentIdx + 1);
        });
      })();
    </script>
  </body>
</html>
