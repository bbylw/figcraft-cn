---
import { look } from "../../data/site";
---

<section class="section wrap" id="look">
  <div class="sec-head">
    <h2 class="t-head reveal">编辑器一览</h2>
    <p class="t-body reveal reveal--d1 sec-head__lead">
      下面每一张都是 FigCraft 自己的界面，不是在浏览器里套壳：没有 Electron，没有 Web 视图。点击任一截图可放大检视界面细节。
    </p>
  </div>

  <div class="look__list">
    {
      look.map((item, i) => (
        <article class={`look__item${i % 2 === 1 ? " look__item--flip" : ""}`}>
          <div class="look__media reveal">
            <div
              class="look__frame"
              role="button"
              tabindex="0"
              aria-label={`放大检视：${item.title}`}
              data-zoom-src={item.src}
              data-zoom-title={item.title}
              data-zoom-caption={item.desc}
              data-zoom-file={item.file ?? ""}
            >
              <img
                class="parallax"
                src={item.src}
                width={item.w}
                height={item.h}
                alt={item.alt}
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
              <span class="look__zoomhint" aria-hidden="true">点击放大检视 ↗</span>
            </div>
          </div>
          <div class="look__text reveal reveal--d1">
            <span class="look__index">{String(i + 1).padStart(2, "0")}.</span>
            <h3 class="look__title">{item.title}</h3>
            <p class="look__desc">{item.desc}</p>
            {item.file && (
              <p class="look__file">
                <span>示例文件</span>
                <code>{item.file}</code>
              </p>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
