---
import { featureCols, features, featureProse, site } from "../../data/site";
---

<section class="section wrap" id="features">
  <div class="sec-head">
    <h2 class="t-head reveal">三种入口，同一条命令</h2>
    <p class="t-body reveal reveal--d1 sec-head__lead">
      每一个菜单项、工具与手势都来自一个拥有 400+ 条命令的注册表。你在界面上点到的任何效果，
      <a class="tlink" href={site.mcp}>命令行与 MCP 服务器</a> 同样能做到。
    </p>
  </div>

  <div class="table reveal reveal--d2" role="table" aria-label="三种入口对比表" style="margin-top: clamp(48px, 6vw, 88px);">
    <div class="table__cell table__head" role="columnheader">能力</div>
    <div class="table__cell table__head" role="columnheader">{featureCols[0]}</div>
    <div class="table__cell table__head" role="columnheader">{featureCols[1]}</div>
    <div class="table__cell table__head table__cell--feathead" role="columnheader">{featureCols[2]}</div>

    {
      features.map((row, i) => (
        <>
          <div class={`table__cell table__cap${i % 2 === 0 ? " table__cell--alt" : ""}`} role="cell">
            {row.name}
          </div>
          <div class={`table__cell${i % 2 === 0 ? " table__cell--alt" : ""}`} role="cell">{row.ui}</div>
          <div class={`table__cell${i % 2 === 0 ? " table__cell--alt" : ""}`} role="cell">
            <Fragment set:html={row.cli} />
          </div>
          <div class={`table__cell table__cell--feat${i % 2 === 0 ? " table__cell--alt" : ""}`} role="cell">
            <Fragment set:html={row.mcp} />
          </div>
        </>
      ))
    }
  </div>

  <div class="table--phone reveal reveal--d2" style="margin-top: 40px;">
    {
      features.map((row, i) => (
        <div class={`tcard${i % 2 === 0 ? " tcard--alt" : ""}`}>
          <div class="tcard__name">{row.name}</div>
          <div class="tcard__line">
            <b>{featureCols[0]}</b>
            <span>{row.ui}</span>
          </div>
          <div class="tcard__line">
            <b>{featureCols[1]}</b>
            <span>
              <Fragment set:html={row.cli} />
            </span>
          </div>
          <div class="tcard__line tcard__line--feat">
            <b>{featureCols[2]}</b>
            <span>
              <Fragment set:html={row.mcp} />
            </span>
          </div>
        </div>
      ))
    }
  </div>

  <div class="featgrid" style="margin-top: clamp(64px, 7vw, 112px);">
    {
      featureProse.map((f, i) => (
        <div class={`featgrid__item reveal${i % 2 === 1 ? " reveal--d1" : ""}`}>
          <span class="featgrid__num">{String(i + 1).padStart(2, "0")}.</span>
          <h3>{f.h}</h3>
          <p>{f.p}</p>
        </div>
      ))
    }
  </div>
</section>
