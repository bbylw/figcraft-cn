---
import { privacy } from "../../data/site";
---

<section class="section darkfield">
  <div class="wrap">
    <h2 class="t-head reveal">分享之前，先知道这些</h2>
    <p class="t-body t-muted reveal reveal--d1" style="max-width: 54ch; margin-top: 20px;">
      FigCraft 可以离线工作：没有账号，没有遥测，在你分享或加入文件之前不会连接任何服务器。
      实时协作会话属于预览功能。
    </p>
    <div class="privacy">
      {
        privacy.map((p, i) => (
          <div class={`reveal${i === 1 ? " reveal--d1" : i === 2 ? " reveal--d2" : ""}`}>
            <h3>{p.h}</h3>
            <p>{p.p}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
