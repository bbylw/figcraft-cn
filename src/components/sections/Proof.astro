---
import { proofTiles, proofFacts } from "../../data/site";
---

<section class="section wrap" id="under-the-hood">
  <div class="board">
    <div class="tile tile--head reveal">
      <h2>底层实现</h2>
      <p class="tile__head-sub">纯数据文档模型 · 零外部 Web 视图依赖</p>
    </div>
    {
      proofTiles.map((t, i) => (
        <div class={`tile reveal${i % 4 === 1 ? " reveal--d1" : i % 4 === 2 ? " reveal--d2" : i % 4 === 3 ? " reveal--d3" : ""}`}>
          <div class="tile__name">{t.name}</div>
          <div class="tile__note">{t.note}</div>
        </div>
      ))
    }
  </div>

  <div class="proof__facts">
    {
      proofFacts.map((f, idx) => (
        <div class="proof__fact reveal">
          <div class="proof__fact-k">
            <span class="proof__fact-num">{String(idx + 1).padStart(2, "0")}.</span>
            <b>{f.k}</b>
          </div>
          <p class="proof__fact-v">{f.v}</p>
        </div>
      ))
    }
  </div>
</section>
