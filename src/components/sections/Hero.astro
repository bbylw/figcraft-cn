---
import VariantBoard from "../react/VariantBoard";
import { hero, nav, site } from "../../data/site";
---

<header class="hero">
  <div class="hero__left">
    <div class="hero__markrow rise rise--d1">
      <img class="hero__mark" src="/img/brand/artcraft-mark.png" alt="ArtCraft" width="1024" height="1024" />
      <span class="hero__wordmark">FigCraft</span>
    </div>

    <div class="hero__foot">
      <h1 class="hero__headline" data-hero-headline>
        <span class="maskline"><span>{hero.line1}</span></span>
        <span class="maskline"><span>{hero.line2}</span></span>
      </h1>
      <p class="hero__sub rise rise--d1">{hero.sub}</p>
      <div class="hero__actions rise rise--d2">
        <a class="btn" href={hero.primary.href}>{hero.primary.label}</a>
        <a class="tlink" href={site.repo}>{hero.secondary.label}</a>
      </div>
    </div>
  </div>

  <div class="hero__right">
    <div class="rise rise--d3">
      <VariantBoard client:load />
    </div>
  </div>

  <nav class="hero__nav" aria-label="页面导航">
    {nav.map((n) => <a class="tlink" href={n.href}>{n.label}</a>)}
  </nav>
</header>
